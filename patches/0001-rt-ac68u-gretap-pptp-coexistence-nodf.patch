+/* ASUS RT-AC68U / Merlin 386.14_2 PPTP coexistence shim. */
+#define ASUS_PPTP_PROTO_ADDR      0xc03da258UL
+#define ASUS_PPTP_RCV_ADDR        0xc01c100cUL
+#define ASUS_PPTP_INIT_ADDR       0xc001e0e0UL
+#define ASUS_INET_ADD_ADDR        0xc023d5c8UL
+#define ASUS_INET_DEL_ADDR        0xc023d580UL
+
+static const struct net_protocol *asus_pptp_proto =
+	(const struct net_protocol *)ASUS_PPTP_PROTO_ADDR;
+static int asus_pptp_displaced;
+
+static int asus_displace_pptp_gre(void)
+{
+	if (kallsyms_lookup_name("pptp_rcv") != ASUS_PPTP_RCV_ADDR ||
+	    kallsyms_lookup_name("pptp_init_module") != ASUS_PPTP_INIT_ADDR ||
+	    kallsyms_lookup_name("inet_add_protocol") != ASUS_INET_ADD_ADDR ||
+	    kallsyms_lookup_name("inet_del_protocol") != ASUS_INET_DEL_ADDR) {
+		printk(KERN_ERR "ipgre-asus: kernel layout guard failed; refusing load\n");
+		return -ENODEV;
+	}
+
+	if (inet_del_protocol(asus_pptp_proto, IPPROTO_GRE) < 0) {
+		printk(KERN_ERR "ipgre-asus: GRE/47 is not owned by expected PPTP handler\n");
+		return -EBUSY;
+	}
+
+	asus_pptp_displaced = 1;
+	printk(KERN_INFO "ipgre-asus: temporarily displaced built-in PPTP GRE handler\n");
+	return 0;
+}
+
+static void asus_restore_pptp_gre(void)
+{
+	if (!asus_pptp_displaced)
+		return;
+
+	if (inet_add_protocol(asus_pptp_proto, IPPROTO_GRE) < 0) {
+		printk(KERN_ERR "ipgre-asus: CRITICAL: failed to restore PPTP GRE handler\n");
+		return;
+	}
+
+	asus_pptp_displaced = 0;
+	printk(KERN_INFO "ipgre-asus: restored built-in PPTP GRE handler\n");
+}
